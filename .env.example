# ==============================================================================
# Nexo Assist — Configuração de Ambiente
# ==============================================================================

# Provedor de LLM para o agente Mastra ("openai" | "google" | "anthropic")
# Caso nenhuma chave seja informada, o Nexo Assist utiliza o motor determinístico
# híbrido local com as mesmas tools tipadas do Mastra, permitindo avaliação imediata.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Chaves de API (preencha a do provedor escolhido; mantenha fora do cliente)
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Caminho do banco SQLite local (persiste conversas, chamados, rascunhos e decisões)
SQLITE_DB_PATH=./data/nexo.db

# Simulação do sistema legado de chamados (0 = estável, 1 = falha transiente simulada)
SIMULATE_LEGACY_INSTABILITY=0
